# Copy to .env (git-ignored) and replace the placeholders. Never commit real secrets.

# Generate with: docker run --rm confluentinc/cp-kafka:7.5.0 kafka-storage random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Neo4j password for user "neo4j" (minimum 8 characters).
NEO4J_PASSWORD=CHANGE_ME_before_use

# Planted-flaw switches for the evaluation target app. Keep all false unless you are
# deliberately attacking it. Values: true / false.
ALLOW_SKIP_PAYMENT=false
ALLOW_POST_SHIP_ADDRESS_EDIT=false
ALLOW_DOUBLE_REFUND=false
ALLOW_BOLA_CANCEL=false