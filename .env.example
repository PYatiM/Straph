# Copy to .env (git-ignored) and replace the placeholders. Never commit real secrets.

# Generate with: docker run --rm confluentinc/cp-kafka:7.5.0 kafka-storage random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Neo4j password for user "neo4j" (minimum 8 characters).
NEO4J_PASSWORD=CHANGE_ME_before_use
