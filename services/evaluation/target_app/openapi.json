  "components": {
    "schemas": {
      "AddCartItemRequest": {
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "title": "Sku"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Quantity",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "sku"
        ],
        "title": "AddCartItemRequest"
      },
      "AddressResponse": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "address": {
            "type": "string",
            "title": "Address"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "state",
          "address"
        ],
        "title": "AddressResponse"
      },
      "CartItemOut": {
        "properties": {
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "sku",
          "quantity"
        ],
        "title": "CartItemOut"
      },
      "CartSummaryResponse": {
        "properties": {
          "owner_sub": {
            "type": "string",
            "title": "Owner Sub"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CartItemOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total_quantity": {
            "type": "integer",
            "title": "Total Quantity"
          }
        },
        "type": "object",
        "required": [
          "owner_sub",
          "items",
          "total_quantity"
        ],
        "title": "CartSummaryResponse"
      },
      "CreateOrderResponse": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "state": {
            "type": "string",
            "title": "State"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "state"
        ],
        "title": "CreateOrderResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderStateResponse": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "state": {
            "type": "string",
            "title": "State"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "state"
        ],
        "title": "OrderStateResponse"
      },
      "PaymentResponse": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "payment_id": {
            "type": "string",
            "title": "Payment Id"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "state",
          "payment_id"
        ],
        "title": "PaymentResponse"
      },
      "PaymentWebhookRequest": {
        "properties": {
          "order_id": {
            "type": "string",
            "minLength": 1,
            "title": "Order Id"
          }
        },
        "type": "object",
        "required": [
          "order_id"
        ],
        "title": "PaymentWebhookRequest"
      },
      "RefundResponse": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "refunded": {
            "type": "boolean",
            "title": "Refunded"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "state",
          "refunded"
        ],
        "title": "RefundResponse"
      },
      "SetAddressRequest": {
        "properties": {
          "address": {
            "type": "string",
            "minLength": 1,
            "title": "Address"
          }
        },
        "type": "object",
        "required": [
          "address"
        ],
        "title": "SetAddressRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
