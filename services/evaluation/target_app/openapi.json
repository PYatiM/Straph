{
  "openapi": "3.0.3",
  "info": {
    "title": "Straph target app",
    "version": "0.1.0"
  },
  "paths": {
    "/cart/items": {
      "post": {
        "summary": "Add Cart Item",
        "operationId": "AddCartItem",
        "parameters": [
          {
            "name": "x-user-sub",
            "in": "header",
            "required": false,
            "schema": {
              "title": "X-User-Sub",
              "nullable": true,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddCartItemRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartSummaryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "summary": "Create Order",
        "operationId": "CreateOrder",
        "parameters": [
          {
            "name": "x-user-sub",
            "in": "header",
            "required": false,
            "schema": {
              "title": "X-User-Sub",
              "nullable": true,
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateOrderResponse"
                }
              }
            },
            "links": {
              "UpdateAddress": {
                "operationId": "UpdateAddress",
                "parameters": {
                  "order_id": "$response.body#/order_id"
                },
                "description": "Set the shipping address of the new order."
              },
              "InitiatePayment": {
                "operationId": "InitiatePayment",
                "parameters": {
                  "order_id": "$response.body#/order_id"
                },
                "description": "Start payment for the new order."
              },
              "CancelOrder": {
                "operationId": "CancelOrder",
                "parameters": {
                  "order_id": "$response.body#/order_id"
                },
                "description": "Cancel the new order."
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}/address": {
      "put": {
        "summary": "Set Address",
