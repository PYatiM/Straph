        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderStateResponse"
                }
              }
            },
            "links": {
              "FulfillOrder": {
                "operationId": "FulfillOrder",
                "parameters": {
                  "order_id": "$response.body#/order_id"
                },
                "description": "The warehouse queues the paid order."
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
